<%- include("./partials/head.ejs") %>
	<body>
		<%- include("./partials/navbar.ejs") %>
		<main class="auth-page">
			<h1>Registrer</h1>
			<form action="/register" method="POST">
				<label for="register-brukernavn">Brukernavn</label>
				<input id="register-brukernavn" name="brukernavn" type="text" required />

				<label for="register-passord">Passord</label>
				<input id="register-passord" name="passord" type="password" required />

				<button type="submit">Registrer</button>
			</form>
			<% if (message) { %>
				<p><%= message %></p>
			<% } %>
			<p><a href="/login">Tilbake til login</a></p>
		</main>
	</body>
