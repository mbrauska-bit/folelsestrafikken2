<!DOCTYPE html>
<html lang="no">

<%- include("./partials/head.ejs") %>

<body>

    <main>
        <h1>Følelsestrafikken</h1>
        <p>Hvordan føles skolehverdagen din akkurat nå?</p>
    </main>

    <div class="trafikk">
        <button class="green">Jeg har det greit!</button>
        <button class="yellow">Det er litt mye akkurat nå!</button>
        <button class="red">Jeg trenger støtte!</button>
    </div>


    <div class="stotte">

        <h2>Hva ønsker du å gjøre?</h2>

        <button class="miljoarbeider">
            Snakke med miljøarbeider
        </button>

        <button class="radgiver">
            Snakke med rådgiver
        </button>

        <button class="helsesykepleier">
            Snakke med helsesykepleier
        </button>

        <button class="ingen-kontakt">
            Jeg vil ikke kontakte noen akkurat nå
        </button>

    </div>


    <div id="resultat"></div>

</body>

</html>